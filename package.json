{
  "name": "glac-master-control",
  "version": "1.0.0",
  "description": "Greenlight Automotive Center Master Control",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "vite",
    "build:react": "vite build",
    "build": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.glac.mastercontrol",
    "productName": "GLAC Master Control",
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0"
  }
}
