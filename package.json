{
  "name": "glac-master-control",
  "version": "1.0.0",
  "description": "Greenlight Automotive Center Master Control",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.glac.mastercontrol",
    "productName": "GLAC Master Control",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "db/**/*"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0"
  }
}
