{
  "name": "glac-master-control",
  "version": "1.0.0",
  "description": "Greenlight Automotive Center - Sales & Marketing Master Control",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.glac.mastercontrol",
    "productName": "GLAC Master Control",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
